# MySQL Workbench wali connection details yahan daalo
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=amplemind_crm
PORT=5000

# ---- Admin login (pehli baar server start hone par ye admin account ban jayega) ----
# Uske baad password CRM ke Settings page se badlo (yahan badalne se kuch nahi hoga)
ADMIN_USER=admin
ADMIN_PASS=Admin@123
ADMIN_NAME=Admin

# ---- Login security ----
# Lamba random text daalo (deploy ke time zaroor). Khali chhoda to har restart par sab logout ho jayenge.
JWT_SECRET=
# Login kitni der valid rahe (12h = 12 ghante)
JWT_EXPIRES=12h
# Attendance / dates ke liye timezone (India = +05:30)
TZ_OFFSET=+05:30
