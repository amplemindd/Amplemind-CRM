# ---- Database (GoDaddy cPanel > MySQL Databases se milne wali details) ----
# Note: GoDaddy me DB name aur user ke aage cPanel username lagta hai, e.g. cpuser_amplemind
DB_HOST=localhost
DB_USER=cpuser_amplemind
DB_PASSWORD=your_db_password
DB_NAME=cpuser_amplemind
# Local par PORT=5000. GoDaddy cPanel Node App par PORT mat likho (wo khud deta hai)
PORT=5000

# ---- Admin login (pehli baar server start hone par ye admin account ban jayega) ----
ADMIN_USER=admin
ADMIN_PASS=ChangeThisStrongPassword
ADMIN_NAME=Admin

# ---- Login security ----
# Lamba random text (60+ characters). Khali chhoda to har restart par sab logout.
JWT_SECRET=
JWT_EXPIRES=12h
TZ_OFFSET=+05:30

# ---- Push notification (app band ho tab bhi notification): `npm run vapid` chalao aur jo 3 line aaye wo yahan daalo ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:aapka-email@example.com
# ---- Optional: call ke liye TURN (Open Relay / Metered ka credentials URL) ----
TURN_CREDENTIALS_URL=
